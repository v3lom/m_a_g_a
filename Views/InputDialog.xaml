<Window x:Class="M_A_G_A.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод" Width="340" Height="170"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{StaticResource Surface2Brush}" Padding="24">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="Введите значение:"
                       FontSize="13" Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBox x:Name="InputBox" FontSize="14" Padding="10,8"
                     Background="{StaticResource Surface3Brush}"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderThickness="0" Margin="0,0,0,14"
                     KeyDown="InputBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Отмена" Click="CancelClick"
                        Padding="14,7" Margin="0,0,8,0" FontSize="12"
                        Background="{StaticResource Surface3Brush}"
                        Foreground="{StaticResource TextBrush}" BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="ОК" Click="OkClick"
                        Padding="20,7" FontSize="12" FontWeight="SemiBold"
                        Background="{StaticResource AccentBrush}"
                        Foreground="{StaticResource BgBrush}" BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
