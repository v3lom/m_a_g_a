                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Выбрать сообщения:" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteSelectedCommand}"
                                    Padding="8,4" Foreground="#FF4444">
                                <TextBlock Text="🗑 Удалить выбранные"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSelectModeCommand}"
                                    Padding="8,4" Margin="4,0,0,0">
                                <TextBlock Text="✕ Отмена"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Character counter -->
                    <TextBlock Text="{Binding MessageLengthInfo}"
                               FontSize="10" Foreground="{StaticResource TextSecBrush}"
                               HorizontalAlignment="Right" Margin="0,2,4,2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════ RIGHT: User Info Panel ════════════════ -->
        <Border Grid.Column="2" Width="220" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0"
                Visibility="{Binding HasSelectedContact, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Padding="20,24">
                    <StackPanel>
