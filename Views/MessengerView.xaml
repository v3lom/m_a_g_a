                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="📱" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💡" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🚀" FontSize="20" Width="36" Height="36" Padding="0"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Border>

                <!-- Input area -->
                <Border Grid.Row="3" Padding="12,10,12,4"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Emoji picker toggle -->
                        <Button Grid.Column="0" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleEmojiPickerCommand}"
                                Width="38" Height="38" Padding="0"
                                ToolTip="Эмодзи" Margin="0,0,4,0">
                            <TextBlock Text="😊" FontSize="17"/>
                        </Button>

                        <!-- Unified attach button -->
                        <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleAttachMenuCommand}"
                                Width="38" Height="38" Padding="0"
                                ToolTip="Прикрепить файл" Margin="0,0,4,0">
                            <TextBlock Text="📎" FontSize="17"/>
                        </Button>

                        <!-- Voice record / stop (now col 2) -->
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding StartVoiceCommand}"
                                Margin="0,0,8,0" Width="38" Height="38" Padding="0"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                ToolTip="Записать голосовое">
                            <TextBlock Text="🎙" FontSize="18"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                Command="{Binding StopVoiceCommand}"
                                Margin="0,0,8,0" Width="38" Height="38" Padding="0"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"
                                Background="#CC0000">
                            <TextBlock Text="⏹" FontSize="18"/>
                        </Button>

                        <!-- Text input (supports markdown, Enter=send, Shift+Enter=newline) -->
                        <TextBox Grid.Column="4" Style="{StaticResource ModernTextBox}"
                                 Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="14,10" FontSize="14"
                                 KeyDown="MessageInput_KeyDown"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Markdown: **жирный** *курсив* `код` [ссылка](url) ~~зачёркнутый~~&#xa;Enter — отправить  Shift+Enter — новая строка"/>

                        <!-- Send button (normal mode) -->
                        <Button Grid.Column="6" Style="{StaticResource IconButton}"
                                Command="{Binding SendTextCommand}"
                                Margin="4,0,0,0" Width="42" Height="42" Padding="0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="➤" FontSize="20" Foreground="White"/>
                        </Button>
                        <!-- Confirm edit button -->
                        <Button Grid.Column="6" Style="{StaticResource IconButton}"
                                Command="{Binding ConfirmEditCommand}"
                                Margin="4,0,0,0" Width="42" Height="42" Padding="0"
                                Background="#003366"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✓" FontSize="20" Foreground="White"/>
                        </Button>
                    </Grid>

                    <!-- Editing indicator -->
                    <Border Background="#181840" CornerRadius="6" Padding="10,4" Margin="0,0,0,2"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️ Редактирование  " FontSize="11" Foreground="#8888FF"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding CancelEditCommand}"
                                    Padding="4,2" FontSize="11">
                                <TextBlock Text="✕ Отмена" Foreground="#FF6666"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Attach popup menu -->
                    <Border Background="{StaticResource Surface3Brush}" CornerRadius="10"
                            Padding="6" Margin="0,0,0,4"
                            Visibility="{Binding ShowAttachMenu, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Command="{Binding SendImageCommand}"
                                    Padding="8,6" Margin="2,0" ToolTip="Изображение">
                                <TextBlock Text="🖼 Фото"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding SendFileCommand}"
                                    Padding="8,6" Margin="2,0" ToolTip="Файл">
                                <TextBlock Text="📄 Файл"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding SendVideoCommand}"
                                    Padding="8,6" Margin="2,0" ToolTip="Видео">
                                <TextBlock Text="🎬 Видео"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding SendVoiceFileCommand}"
                                    Padding="8,6" Margin="2,0" ToolTip="Аудиофайл">
                                <TextBlock Text="🎵 Аудио"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Selection toolbar -->
