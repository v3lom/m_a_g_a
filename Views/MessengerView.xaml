                                </Border.Background>
                            </Border>
                            <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Fill="{Binding SelectedContact.IsOnline, Converter={StaticResource BoolToColor}}"
                                     Stroke="{StaticResource SurfaceBrush}" StrokeThickness="3"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedContact.Username}"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{Binding SelectedContact.IsOnline, Converter={StaticResource BoolToColor}}"/>
                            <TextBlock Text="{Binding SelectedContact.StatusText}"
                                       FontSize="12" Foreground="{StaticResource TextSecBrush}"/>
                        </StackPanel>
                        <!-- Bio text -->
                        <Border Background="{StaticResource Surface3Brush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,16"
                                Visibility="{Binding SelectedContact.HasBio, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedContact.Bio}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecBrush}"
                                       FontStyle="Italic"/>
                        </Border>

                        <!-- Unread badge -->
                        <Border Background="#CC2244" CornerRadius="10" Padding="10,4" Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                Visibility="{Binding SelectedContact.HasUnread, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" Foreground="White">
                                <Run Text="{Binding SelectedContact.UnreadCount}"/>
                                <Run Text=" непрочитанных"/>
                            </TextBlock>
                        </Border>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,0,0,20"/>
                        <TextBlock Text="И Н Ф О Р М А Ц И Я" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,14"/>

                        <!-- hostname -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Hostname" FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedContact.Hostname}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- MAC -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="MAC-адрес" FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedContact.MacAddress}" FontSize="12" TextWrapping="Wrap"
                                       FontFamily="Consolas"/>
                        </StackPanel>

                        <!-- IPv4 -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="IPv4" FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedContact.IpAddress}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- IPv6 -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding SelectedContact.IPv6, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="IPv6" FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedContact.IPv6}" FontSize="11" TextWrapping="Wrap"
                                       FontFamily="Consolas"/>
                        </StackPanel>

                        <!-- Port -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Порт TCP" FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedContact.TcpPort}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Последняя активность" FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedContact.StatusText}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Per-chat background -->
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,14,0,14"/>
                        <TextBlock Text="НАСТРОЙКИ ЧАТА" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,10"/>
                        <Button Content="🖼 Обои чата" Style="{StaticResource IconButton}"
                                Command="{Binding PickContactBackgroundCommand}"
                                Background="{StaticResource Surface3Brush}"
                                Padding="10,6" FontSize="11" HorizontalAlignment="Stretch"
                                Margin="0,0,0,6" ToolTip="Установить обои для этого чата"/>
                        <Button Content="✕ Убрать обои" Style="{StaticResource IconButton}"
                                Command="{Binding ClearContactBackgroundCommand}"
                                Background="{StaticResource Surface3Brush}"
                                Padding="10,6" FontSize="11" HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"
                                Visibility="{Binding SelectedContact.HasChatBackground, Converter={StaticResource BoolToVis}}"
                                ToolTip="Убрать обои этого чата"/>

                        <!-- Folder assignment -->
                        <TextBlock Text="ПАПКА" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecBrush}" Margin="0,0,0,6">
                            <Run Text="Текущая: "/>
                            <Run Text="{Binding SelectedContact.FolderName, TargetNullValue='Без папки'}" Foreground="White"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Folders}"
                                      Visibility="{Binding Folders.Count, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetContactFolderCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Name}"
                                            Style="{StaticResource IconButton}"
                                            Background="{StaticResource Surface3Brush}"
                                            Padding="8,4" Margin="0,2" HorizontalAlignment="Stretch"
                                            FontSize="11">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="📁 "/>
                                            <Run Text="{Binding Name}"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="✕ Без папки" Style="{StaticResource IconButton}"
                                Command="{Binding SetContactFolderCommand}"
                                CommandParameter="{x:Null}"
                                Background="{StaticResource Surface3Brush}"
                                Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Stretch" FontSize="11"
                                Visibility="{Binding SelectedContact.FolderName, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>