                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🙄" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🤩" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="😏" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="😤" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🥶" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <!-- Love -->
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="❤️" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🧡" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💛" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💚" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💙" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💜" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🖤" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💔" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💕" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="😘" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <!-- Hands -->
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="👍" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="👎" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="👋" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🤝" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🙏" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="✊" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="✌️" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="👌" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🤙" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="💪" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <!-- Nature/Fun -->
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🔥" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="✨" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="⭐" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🌟" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🌈" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🌸" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🎉" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🎊" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🎈" FontSize="20" Width="36" Height="36" Padding="0"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding InsertEmojiCommand}" CommandParameter="🎁" FontSize="20" Width="36" Height="36" Padding="0"/>
